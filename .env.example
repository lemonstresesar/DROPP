# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Admin SDK (JSON string or base64-encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT=""

# Seed script credentials (used only by `npm run seed`, never in client code)
SEED_ADMIN_EMAIL="admin@dropp.test"
SEED_ADMIN_PASSWORD=""
SEED_VENDOR1_EMAIL="vendeur1@dropp.test"
SEED_VENDOR1_PASSWORD=""
SEED_VENDOR2_EMAIL="vendeur2@dropp.test"
SEED_VENDOR2_PASSWORD=""
SEED_VENDOR3_EMAIL="vendeur3@dropp.test"
SEED_VENDOR3_PASSWORD=""
SEED_PENDING_VENDOR_EMAIL="attente@dropp.test"
SEED_PENDING_VENDOR_PASSWORD=""
SEED_SUSPENDED_VENDOR_EMAIL="suspendu@dropp.test"
SEED_SUSPENDED_VENDOR_PASSWORD=""
SEED_CLIENT_EMAIL="client@dropp.test"
SEED_CLIENT_PASSWORD=""

# Cloudinary (Server-side secrets only — never prefix with VITE_)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
